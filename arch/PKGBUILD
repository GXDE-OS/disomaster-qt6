# Maintainer: CharOfString <root@charofstring.cc>
pkgname=disomaster-qt6
pkgver=1.0.0
pkgrel=1
pkgdesc='libisoburn wrapper for Qt6 (GXDE port of disomaster)'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/disomaster-qt6"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'libisoburn' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja')
provides=("disomaster-qt6-git=$pkgver")
conflicts=('disomaster-qt6-git')
replaces=('disomaster-qt6-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
